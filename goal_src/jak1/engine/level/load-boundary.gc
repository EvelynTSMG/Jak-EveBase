         (a0-3 (-> v1-0 arg1 v0))
         (a1-3 (-> v1-0 arg1 v1))
         (f0-1 (- (-> v1-0 a0-3 x) (-> v1-0 a1-3 x)))
         (f1-2 (- (-> v1-0 a0-3 z) (-> v1-0 a1-3 z)))
         (a2-10 (-> v1-0 a1-3 v1)))
    (while (!= a2-10 a0-3)
      (let ((f2-2 (- (-> v1-0 a2-10 x) (-> v1-0 a1-3 x)))
            (f3-2 (- (-> v1-0 a2-10 z) (-> v1-0 a1-3 z))))
        (if (< (- (* f2-2 f1-2) (* f0-1 f3-2)) 0.0) (return #f)))
      (set! a2-10 (-> v1-0 a2-10 v1))))
  #t)

(defun split-monotone-polygon ((arg0 load-boundary) (arg1 int))
  (let ((s5-0 *triangulation-buffer*))
    (loop
      (when (= (-> s5-0 (-> s5-0 (-> s5-0 arg1 v0) v0) v0) arg1)
        (let ((v1-10 (-> arg0 tri-cnt)))
          (set! (-> arg0 data v1-10 v0) (the-as uint arg1))
          (set! (-> arg0 data v1-10 v1) (-> s5-0 arg1 v0))
          (set! (-> arg0 data v1-10 v2) (-> s5-0 (-> s5-0 arg1 v0) v0)))
        (+! (-> arg0 tri-cnt) 1)
        (return 0))
      (let ((s3-0 arg1))
        (while (not (try-corner arg0 s3-0))
          (set! s3-0 (the-as int (-> s5-0 s3-0 v1)))
          (when (= (the-as uint s3-0) arg1)))
        (let ((a0-13 (-> arg0 tri-cnt)))
          (set! arg1 (the-as int (-> s5-0 s3-0 v0)))
          (let ((v1-25 (-> s5-0 s3-0 v1)))
            (set! (-> arg0 data a0-13 v0) (the-as uint arg1))
            (set! (-> arg0 data a0-13 v1) (the-as uint s3-0))
            (set! (-> arg0 data a0-13 v2) v1-25)
            (+! (-> arg0 tri-cnt) 1)
            (set! (-> s5-0 (the-as uint arg1) v1) v1-25)
            (set! (-> s5-0 v1-25 v0) (the-as uint arg1)))))))
  0
  (none))

(defun fix-boundary-normals ((arg0 load-boundary))
  (dotimes (s5-0 (-> arg0 tri-cnt))
    (let ((a1-0 (-> arg0 data (-> arg0 data s5-0 v0)))
          (a2-0 (-> arg0 data (-> arg0 data s5-0 v1)))
          (a3-0 (-> arg0 data (-> arg0 data s5-0 v2)))
          (s4-0 (new 'stack-no-clear 'vector)))
      (normal-of-plane s4-0 (-> a1-0 v) (-> a2-0 v) (-> a3-0 v))
      (if (or (!= (-> s4-0 x) 0.0) (!= (-> s4-0 z) 0.0)) (format 0 "ERROR in the load-boundary code : tell Eddie!!!~%"))
      (when (< (-> s4-0 y) 0.0)
        (let ((v1-22 (-> arg0 data s5-0 v0)))
          (set! (-> arg0 data s5-0 v0) (-> arg0 data s5-0 v1))
          (set! (-> arg0 data s5-0 v1) v1-22)))))
  0
  (none))

(defun point-in-polygon ((arg0 load-boundary) (arg1 vector))
  (dotimes (v1-0 (-> arg0 tri-cnt))
    (let* ((a2-5 (-> arg0 data (-> arg0 data v1-0 v0)))
           (t0-0 (-> arg0 data (-> arg0 data v1-0 v1)))
           (a3-10 (-> arg0 data (-> arg0 data v1-0 v2)))
           (f0-1 (- (-> t0-0 x) (-> a3-10 x)))
           (f1-2 (- (-> t0-0 z) (-> a3-10 z)))
           (f2-2 (- (-> t0-0 x) (-> arg1 x)))
           (f3-2 (- (-> t0-0 z) (-> arg1 z))))
      (when (>= (- (* f2-2 f1-2) (* f0-1 f3-2)) 0.0)
        (let ((f0-5 (- (-> t0-0 x) (-> arg1 x)))
              (f1-7 (- (-> t0-0 z) (-> arg1 z)))
              (f2-5 (- (-> t0-0 x) (-> a2-5 x)))
              (f3-5 (- (-> t0-0 z) (-> a2-5 z))))
          (when (>= (- (* f2-5 f1-7) (* f0-5 f3-5)) 0.0)
            (let ((f0-9 (- (-> arg1 x) (-> a3-10 x)))
                  (f1-12 (- (-> arg1 z) (-> a3-10 z)))
                  (f2-8 (- (-> arg1 x) (-> a2-5 x)))
                  (f3-8 (- (-> arg1 z) (-> a2-5 z))))
              (if (>= (- (* f2-8 f1-12) (* f0-9 f3-8)) 0.0) (return #t))))))))
  #f)

(defun check-closed-boundary ((arg0 load-boundary) (arg1 lbvtx) (arg2 lbvtx))
  (if (and (< (-> arg0 top-plane) (-> arg1 y)) (< (-> arg0 top-plane) (-> arg2 y))) (return (the-as symbol 0)))
  (if (and (< (-> arg1 y) (-> arg0 top-plane)) (< (-> arg2 y) (-> arg0 top-plane))) (return (the-as symbol 0)))
  (let ((f0-6 (/ (- (-> arg1 y) (-> arg2 y)) (- (-> arg0 top-plane) (-> arg2 y))))
        (a1-1 (new 'stack-no-clear 'vector)))
    (set! (-> a1-1 x) (+ (-> arg2 x) (* f0-6 (- (-> arg1 x) (-> arg2 x)))))
    (set! (-> a1-1 y) (+ (-> arg2 y) (* f0-6 (- (-> arg1 y) (-> arg2 y)))))
    (set! (-> a1-1 z) (+ (-> arg2 z) (* f0-6 (- (-> arg1 z) (-> arg2 z)))))
    (when (point-in-polygon arg0 a1-1)
      (if (< (-> arg0 top-plane) (-> arg1 y)) (return (the-as symbol 2)))
      (return (the-as symbol 1))))
  (the-as symbol 0))

(defun check-open-boundary ((arg0 load-boundary) (arg1 lbvtx) (arg2 lbvtx))
  (let ((f0-0 (-> arg2 x))
        (f1-0 (-> arg2 z))
        (f2-0 (-> arg1 x))
        (f3-0 (-> arg1 z))
        (f6-0 (-> arg0 data 0 x))
        (f7-0 (-> arg0 data 0 z))
        (a3-0 1)
        (v1-0 0))
    (if (and (= f0-0 f2-0) (= f1-0 f3-0)) (return (the-as symbol 0)))
    (let ((f4-0 (- f2-0 f0-0))
          (f5-0 (- f3-0 f1-0)))
      (while (< a3-0 (the-as int (-> arg0 num-points)))
        (let ((f8-0 (-> arg0 data a3-0 x))
              (f9-0 (-> arg0 data a3-0 z)))
          (let ((f10-2 (- (* (- f7-0 f1-0) f4-0) (* (- f6-0 f0-0) f5-0)))
                (f11-4 (- (* (- f7-0 f1-0) (- f8-0 f6-0)) (* (- f6-0 f0-0) (- f9-0 f7-0))))
                (f12-5 (- (* (- f8-0 f6-0) f5-0) (* (- f9-0 f7-0) f4-0))))
            (when (!= f12-5 0.0)
              (let ((f10-3 (/ f10-2 f12-5))
                    (f11-5 (/ f11-4 f12-5)))
                (if (and (>= f10-3 0.0) (>= 1.0 f10-3)) 0)
                (when (and (>= f10-3 0.0) (>= 1.0 f10-3) (< 0.0 f11-5) (>= 1.0 f11-5))
                  (let ((f10-5 (+ (-> arg2 y) (* f10-3 (- (-> arg1 y) (-> arg2 y))))))
                    (when (and (>= f10-5 (-> arg0 bot-plane)) (>= (-> arg0 top-plane) f10-5))
                      (let ((f6-3 (- (* (- f2-0 f6-0) (- f9-0 f7-0)) (* (- f3-0 f7-0) (- f8-0 f6-0)))))
                        (if (< 0.0 f6-3) (+! v1-0 1) (+! v1-0 -1)))))))))
          (set! f6-0 f8-0)
          (set! f7-0 f9-0))
        (+! a3-0 1)))
    (if (> v1-0 0) (return (the-as symbol 1)))
    (if (< v1-0 0) (return (the-as symbol 2))))
  (the-as symbol 0))

;;;;;;;;;;;;;;;;;;;;;;;;
;; Load Commands
;;;;;;;;;;;;;;;;;;;;;;;;

(defun command-get-int ((param object) (fallback int))
  (cond
    ((null? param)
      fallback
    )

    ((type-type? (rtype-of param) binteger)
      (/ (the-as int param) 8)
    )

    ((type-type? (rtype-of param) bfloat)
      (the int (-> (the-as bfloat param) data))
    )

    (else
      fallback
    )
  )
)

(defun command-get-float ((param object) (fallback float))
  (cond
    ((null? param)
      fallback
    )

    ((type-type? (rtype-of param) binteger)
      (the float (/ (the-as int param) 8))
    )

    ((type-type? (rtype-of param) bfloat)
      (-> (the-as bfloat param) data)
    )

    (else
      fallback
    )
  )
)

(defun command-get-time ((param object) (fallback int))
  (cond
    ((null? param)
      fallback
    )

    ((and
      (pair? param)
      (= (car param) 'seconds)
    )
      (the int (* 300.0 (command-get-float (car (cdr param)) 0.0)))
    )

    ((type-type? (rtype-of param) binteger)
      (/ (the-as int param) 8)
    )

    ((type-type? (rtype-of param) bfloat)
      (the int (-> (the-as bfloat param) data))
    )

    (else
      fallback
    )
  )
)

(defun command-get-param ((param object) (fallback object))
  (cond
    ((null? param)
      fallback
    )

    ((and
      (pair? param)
      (= (car param) 'seconds)
    )
      (seconds (command-get-float (car (cdr param)) 0.0))
    )

    ((and
      (pair? param)
      (= (car param) 'meters)
    )
      (meters (command-get-float (car (cdr param)) 0.0))
    )

    ((and
      (pair? param)
      (= (car param) 'deg)
    )
      (degrees (command-get-float (car (cdr param)) 0.0))
    )

    ((and
      (pair? param)
      (= (car param) 'static-vectorm)
    )
      (let ((vec (new 'static 'vector)))
        (set-vector! vec
          (meters (command-get-float (car (cdr param)) 0.0))
          (meters (command-get-float (car (cdr (cdr param))) 0.0))
          (meters (command-get-float (car (cdr (cdr (cdr param)))) 0.0))
          1.0
        )

       (the-as object vec)
      )
    )

    ((type-type? (rtype-of param) binteger)
      (/ (the-as int param) 8)
    )

    ((type-type? (rtype-of param) bfloat)
      (-> (the-as bfloat param) data)
    )

    (else
      param
    )
  )
)

(defun command-get-quoted-param ((param object) (fallback object))
  (if (and
    (pair? param)
    (= (car param) 'quote)
  )
    (command-get-param (car (cdr param)) fallback)
    (command-get-param param fallback)
  )
)

(defmethod reset! ((this load-state))
  (set! (-> this want 0 name) #f)
  (set! (-> this want 0 display?) #f)
  (set! (-> this want 0 force-vis?) #f)
  (set! (-> this want 0 force-inside?) #f)
  (set! (-> this want 1 name) #f)
  (set! (-> this want 1 display?) #f)
  (set! (-> this want 1 force-vis?) #f)
  (set! (-> this want 1 force-inside?) #f)
  (set! (-> this command-list) '())
  (dotimes (v1-1 256)
    (set! (-> this object-name v1-1) #f)
    (set! (-> this object-status v1-1) (the-as basic 0)))
  this)

(defmethod want-levels ((this load-state) (arg0 symbol) (arg1 symbol))
  (dotimes (v1-0 2)
    (cond
      ((= (-> this want v1-0 name) arg0) (set! arg0 #f))
      ((= (-> this want v1-0 name) arg1) (set! arg1 #f))
      (else (set! (-> this want v1-0 name) #f))))
  (when arg0
    (dotimes (v1-4 2)
      (when (not (-> this want v1-4 name))
        (set! (-> this want v1-4 name) arg0)
        (set! (-> this want v1-4 display?) #f)
        (set! (-> this want v1-4 force-vis?) #f)
        (set! (-> this want v1-4 force-inside?) #f)
        (set! v1-4 2))))
  (when arg1
    (dotimes (v1-10 2)
      (when (not (-> this want v1-10 name))
        (set! (-> this want v1-10 name) arg1)
        (set! (-> this want v1-10 display?) #f)
        (set! (-> this want v1-10 force-vis?) #f)
        (set! (-> this want v1-10 force-inside?) #f)
        (set! v1-10 2))))
  0)

(defmethod want-display-level ((this load-state) (arg0 symbol) (arg1 symbol))
  (dotimes (v1-0 2)
    (when (= (-> this want v1-0 name) arg0)
      (set! (-> this want v1-0 display?) arg1)
      (return 0)))
  (if arg1 (format 0 "ERROR: can't display ~A because it isn't loaded~%" arg0))
  0)

(defmethod want-vis ((this load-state) (arg0 symbol))
  (set! (-> this vis-nick) arg0)
  0)

(defmethod want-force-vis ((this load-state) (arg0 symbol) (arg1 symbol))
  (dotimes (v1-0 2)
    (when (= (-> this want v1-0 name) arg0)
      (set! (-> this want v1-0 force-vis?) arg1)
      (return 0)))
  (format 0 "ERROR: can't force vis on ~A because it isn't loaded~%" arg0)
  0)

(defmethod set-force-inside! ((this load-state) (arg0 symbol) (arg1 symbol))
  (dotimes (v1-0 2)
    (when (= (-> this want v1-0 name) arg0)
      (set! (-> this want v1-0 force-inside?) arg1)
      (return 0)))
  (format 0 "ERROR: can't force inside on ~A because it isn't loaded~%" arg0)
  0
  (none))

(defun load-state-want-levels ((arg0 symbol) (arg1 symbol))
  (want-levels *load-state* arg0 arg1))

(defun load-state-want-display-level ((arg0 symbol) (arg1 symbol))
  (want-display-level *load-state* arg0 arg1))

(defun load-state-want-vis ((arg0 symbol))
  (want-vis *load-state* arg0))

(defun load-state-want-force-vis ((arg0 symbol) (arg1 symbol))
  (want-force-vis *load-state* arg0 arg1))

(define *display-load-commands* #f)

(define *backup-load-state* (new 'global 'load-state))

(defmethod backup-load-state-and-set-cmds ((this load-state) (arg0 pair))
  (dotimes (s4-0 256)
    (when (-> this object-name s4-0)
      (format 0 "WARNING: load state somehow aquired object command ~A~%" (-> this object-name s4-0))
      (set! (-> this object-name s4-0) #f)))
  (mem-copy! (&-> *backup-load-state* type) (&-> this type) 2092)
  (set! (-> *backup-load-state* command-list) '())
  (set! (-> this command-list) arg0)
  0)

(defmethod restore-load-state-and-cleanup ((this load-state))
  (execute-commands-up-to this 100000.0)
  (dotimes (s5-0 256)
    (when (-> this object-name s5-0)
      (let ((a0-3 (entity-by-name (the-as string (-> this object-name s5-0)))))
        (set! (-> a0-3 extra perm status) (the-as entity-perm-status (-> this object-status s5-0)))
        (if (-> a0-3 extra process) (kill! a0-3)))
      (set! (-> this object-name s5-0) #f)))
  (mem-copy! (&-> this type) (&-> *backup-load-state* type) 2092)
  0)

(defmethod restore-load-state ((this load-state))
  (dotimes (v1-0 256)
    (if (-> this object-name v1-0) (set! (-> this object-name v1-0) #f)))
  (mem-copy! (&-> this type) (&-> *backup-load-state* type) 2092)
  0)

;; Get a process from a command param.
;; If this fails, return #f.
;; Options, if the param is:
;; - a process, return the param
;; - 'target, return *target*
;; - 'sidekick, return the sidekick process from *target*
;; - 'self, return the current process
;; - 'parent, return the parent of the current process
;; - 'camera, return *camera*
;; a string, return the process of the entity with a matching name, if none match:
;; a string, return the child of the current process with a matching art group name
(defun command-list-get-process ((proc-param object))
  (with-pp
    (set! proc-param
      (cond
        ((null? proc-param)
          #f
        )

        ((type-type? (rtype-of proc-param) process)
          proc-param
        )

        ((= proc-param 'target)
          *target*
        )

        ((= proc-param 'sidekick)
          (if *target*
            (ppointer->process (-> *target* sidekick))
          )
        )

        ((= proc-param 'self)
          pp
        )

        ((= proc-param 'parent)
          (ppointer->process (-> pp parent))
        )

        ((= proc-param 'camera)
          *camera*
        )

        ((type-type? (rtype-of proc-param) string)
          (let ((proc (process-by-ename (the-as string proc-param))))
            (cond
              (proc
                proc
              )

              (else
                (let ((child (ppointer->process (-> pp child))))
                  (while child
                    (let* (
                      (current-child child)
                      (current-draw-proc (ensure-type current-child process-drawable))
                    )
                      (when (and
                        current-draw-proc
                        (nonzero? (-> (the-as process-drawable current-draw-proc) draw))
                        (nonzero? (-> (the-as process-drawable current-draw-proc) draw art-group))
                        (string=
                          (the-as string proc-param)
                          (-> (the-as process-drawable current-draw-proc) draw art-group name)
                        )
                      )
                        (set! proc-param current-draw-proc)
                        (return (the-as process proc-param))
                      )
                    )

                    (set! child (ppointer->process (-> child brother)))
                  )
                )

                (the-as process #f)
              )
            )
          )
        )

        (else
          #f
        )
      )
    )

    (the-as process proc-param)
  )
)

(defmethod execute-commands-up-to ((this load-state) (arg0 float))
  (while (not (null? (-> this command-list)))
    (let ((f0-0 (command-get-float (car (car (-> this command-list))) 0.0))
          (s4-0 (cdr (car (-> this command-list)))))
      (if (< arg0 f0-0) (return (the-as int #f)))
      (if *display-load-commands* (format 0 "NOTICE: ~D: ~f: execute command ~A~%" (current-time) f0-0 s4-0))
      (cond
        ((pair? (car s4-0))
         (let ((a1-3 (car s4-0)))
           (while (not (null? s4-0))
             (execute-command this (the-as pair a1-3))
             (set! s4-0 (cdr s4-0))
             (set! a1-3 (car s4-0)))))
        (else (execute-command this s4-0))))
    (set! (-> this command-list) (cdr (-> this command-list))))
  0)

(defmethod execute-command ((this load-state) (command-pair pair))
  (with-pp
    (cond
      ((null? command-pair))

      ((pair? command-pair)
        (let (
          (command (car command-pair))
          (params (cdr command-pair))
        )
          (cond
            ;; Set a symbol to a value.
            ;; Silently fails if the symbol is #f.
            ;; Params:
            ;; - Symbol to set.
            ;;   Defaults to #f.
            ;; - Value to set the symbol to.
            ;;   Defaults to #f.
            ((= command 'set!)
              (let ((sym (command-get-param (car params) #f)))
                (if sym
                  (set! (-> (the-as symbol sym) value) (command-get-param (car (cdr params)) #f))
                )
              )
            )

            ;; Run a function.
            ;; Params:
            ;; - Function to run, returns an integer.
            ;;   Defaults to #f.
            ((= command 'eval)
              ((the-as (function int) (command-get-param (car params) #f)))
            )

            ;; Ask for a vis to be loaded.
            ;; Params:
            ;; - Nick of the vis to load.
            ;;   Defaults to #f.
            ((= command 'want-vis)
              (want-vis this (the-as symbol (command-get-param (car params) #f)))
            )
            
            ;; Ask for levels to be loaded.
            ;; Will not reload levels.
            ;; Params:
            ;; - Nick of the first level to load.
            ;;   Defaults to #f.
            ;; - Nick of the second level to load.
            ;;   Defaults to #f.
            ((= command 'want-levels)
              (want-levels this
                (the-as symbol (command-get-param (car params) #f))
                (the-as symbol (command-get-param (car (cdr params)) #f))
              )
            )

            ;; Ask for levels to be displayed.
            ;; Fails if the level is not loaded.
            ;; Params:
            ;; - Nick of the level to display.
            ;;   Defaults to #f.
            ;; - #t/#f Whether to print an error message if this fails.
            ;;   Defaults to #f.
            ((= command 'display-level)
              (want-display-level this
                (the-as symbol (command-get-param (car params) #f))
                (the-as symbol (command-get-param (car (cdr params)) #f))
              )
            )

            ;; Force vis on a level.
            ;; Fails if the level is not loaded.
            ;; Params:
            ;; - Nick of the level to force vis on.
            ;;   Defaults to #f.
            ;; - #t/#f Whether to force vis on the level.
            ;;   Defaults to #f.
            ((= command 'want-force-vis)
              (want-force-vis this
                (the-as symbol (command-get-param (car params) #f))
                (the-as symbol (command-get-param (car (cdr params)) #f))
              )
            )

            ;; Set whether to force every point to be considered inside a level
            ;; Fails if the level is not loaded.
            ;; Params:
            ;; - Nick of the level.
            ;;   Defaults to #f.
            ;; - #t/#f Whether to force every point to be considered inside the level.
            ;;   Defaults to #f.
            ((= command 'want-force-inside)
              (set-force-inside! this
                (the-as symbol (command-get-param (car params) #f))
                (the-as symbol (command-get-param (car (cdr params)) #f))
              )
            )

            ;; Make sure an entity is alive.
            ;; If the entity is not alive, birth it.
            ;; Params:
            ;; - Name of the entity to birth.
            ;;   Defaults to #f.
            ((= command 'alive)
              (let ((entity-name (command-get-param (car params) #f)))
                (when entity-name
                  (let ((entity (entity-by-name (the-as string entity-name))))
                    (when entity
                      (let ((found-idx -1))
                        (dotimes (i 256)
                          (when (not (-> this object-name i))
                            (set! (-> this object-name i) (the-as symbol entity-name))
                            (set! (-> this object-status i) (the-as basic (-> entity extra perm status)))
                            (set! found-idx i)

                            (goto found-alive)
                          )
                        )

                        (label found-alive)

                        (when (>= found-idx 0)
                          (entity-birth-no-kill entity)

                          (let ((entity-process (-> entity extra process)))
                            (when entity-process
                              (logclear! (-> entity-process mask) (process-mask actor-pause))
                              (logclear! (-> entity-process mask) (-> *kernel-context* prevent-from-run))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )

            ;; Make sure an entity is dead.
            ;; If the entity is not dead, kill it.
            ;; Also frees the associated object in the load-state.
            ;; Params:
            ;; - Name of the entity to kill.
            ;;   Defaults to #f.
            ((= command 'dead)
              (let ((entity-name (command-get-param (car params) #f)))
                (when entity-name
                  (let ((entity (entity-by-name (the-as string entity-name))))
                    (when entity
                      (dotimes (i 256)
                        (when (string= (the-as string (-> this object-name i)) (the-as string entity-name))
                          (set! (-> entity extra perm status) (the-as entity-perm-status (-> this object-status i)))
                          (if (-> entity extra process)
                            (kill! entity)
                          )
                          (set! (-> this object-name i) #f)

                          (goto ensured-dead)
                        )
                      )
                    )
                  )
                )
              )

              (label ensured-dead)
            )

            ;; Make sure an entity is dead.
            ;; If the entity is not dead, kill it.
            ;; Leaves the entity with the `dead` perm status.
            ;; Params:
            ;; - Name of the entity to kill.
            ;;   Defaults to #f.
            ((= command 'kill)
              (let ((entity-name (command-get-param (car params) #f)))
                (when entity-name
                  (let ((entity (entity-by-name (the-as string entity-name))))
                    (when entity
                      (let ((found-idx -1))
                        (dotimes (i 256)
                          (when (not (-> this object-name i))
                            (set! (-> this object-name i) (the-as symbol entity-name))
                            (set! (-> this object-status i) (the-as basic (-> entity extra perm status)))
                            (set! found-idx i)

                            (goto found-dead)
                          )
                        )

                        (label found-dead)

                        (when (>= found-idx 0)
                          (if (-> entity extra process)
                            (kill! entity)
                          )
                          (logior! (-> entity extra perm status) (entity-perm-status dead))
                        )
                      )
                    )
                  )
                )
              )
            )

            ;; Sets or clears bit-7 from an entity's perm status.
            ;; Params:
            ;; - Name of the entity to set the perm status of.
            ;;   Defaults to #f.
            ;; - #t/#f Whether to set or clear bit-7 in the perm status.
            ;;   Defaults to #f.
            ((= command 'special)
              (let ((entity-name (command-get-param (car params) #f)))
                (when entity-name
                  (let ((entity (entity-by-name (the-as string entity-name))))
                    (if entity
                      (set-or-clear-status! (the-as entity-actor entity)
                        (entity-perm-status bit-7)
                        (the-as symbol (command-get-param (car (cdr params)) #f))
                      )
                    )
                  )
                )
              )
            )

            ;; Wait for a level to be active.
            ;; Params:
            ;; - Name of the level to wait for.
            ;;   Defaults to #f.
            ((= command 'active)
              (let ((level-name (command-get-param (car params) #f)))
                (while (!= (level-status *level* (the-as symbol level-name)) 'active)
                  (suspend)
                )
              )
            )

            ;; Initialize a particle tracker on top of an entity.
            ;; The entity process must be a process-drawable.
            ;; Params:
            ;; - The name of the particle group to initialize the tracker with.
            ;;   Defaults to #f.
            ;; - The name of the entity to put the tracker on.
            ;;   Defaults to #f.
            ((= command 'part-tracker)
              (let* (
                (part-group-name (command-get-param (car params) #f))
                (entity-name (command-get-param (car (cdr params)) #f))
                (entity (entity-by-name (the-as string entity-name)))
                (part-group (lookup-part-group-by-name (symbol->string (the-as symbol part-group-name))))
                (launch-group (ensure-type part-group sparticle-launch-group))
              )
                (when (and
                  entity
                  launch-group
                )
                  (let* (
                    (proc (-> entity extra process))
                    (draw-proc (try-as process-drawable proc))
                    (tracker (get-process *default-dead-pool* part-tracker #x4000))
                  )
                    (when tracker
                      (let ((movie (ppointer->process (-> *setting-control* current movie))))
                        (set! movie
                          (cond
                            (movie movie)
                            (else *entity-pool*)
                          )
                        )
                        (activate (the-as part-tracker tracker) movie 'part-tracker (the-as pointer #x70004000))
                      )

                      (run-now-in-process tracker
                        part-tracker-init
                        launch-group
                        -1
                        #f
                        #f
                        #f
                        (if draw-proc
                          (-> draw-proc root trans)
                          (-> entity extra trans)
                        )
                      )

                      (-> tracker ppointer)
                    )
                  )
                )
              )
            )

            ;; Trigger an auto-save.
            ;; Params:
            ;; - The desired mode of the auto-save, usually `auto-save`.
            ;;   Defaults to #f.
            ((= command 'auto-save)
              (auto-save-command (the-as symbol (command-get-param (car params) #f)) 0 0 *default-pool*)
            )

            ;; Show or hide a shadow for a process by sending a 'shadow event.
            ;; Params:
            ;; - The process to send the event to.
            ;;   Includes shortcuts. See `command-list-get-process` for details.
            ;; - #t/#f Whether to show or hide the shadow.
            ;;   Defaults to #f.
            ((= command 'shadow)
              (let (
                (proc (command-list-get-process (car params)))
                (enable (command-get-quoted-param (car (cdr params)) #f))
              )
                (send-event proc 'shadow enable)
              )
            )

            ;; Set the current time of day.
            ;; Setting the time of day freezes it.
            ;; To unfreeze the time of day, use -1 as the param.
            ;; Params:
            ;; - The hour to set the time of day to, or -1.
            ;;   Defaults to 0.
            ((= command 'time-of-day)
              (when *time-of-day-proc*
                (let ((desired-hour (command-get-int (car params) 0)))
                  (cond
                    ((< desired-hour 0)
                      (set! (-> *time-of-day-proc* 0 time-ratio) 300.0)
                    )

                    (else
                      (set! (-> *time-of-day-proc* 0 hour) desired-hour)
                      (set! (-> *time-of-day-proc* 0 minute) 0)
                      (set! (-> *time-of-day-proc* 0 frame) 0)
                      (set! (-> *time-of-day-proc* 0 time-ratio) 0.0)
                    )
                  )
                )
              )
            )

            ;; Save the current load state to the backup load state.
            ;; No params.
            ((= command 'save)
              (mem-copy! (&-> *backup-load-state* type) (&-> this type) 2092)
              (set! (-> *backup-load-state* command-list) '())
              (dotimes (i 256)
                (if (-> *backup-load-state* object-name i)
                  (set! (-> *backup-load-state* object-name i) #f)
                )
              )
            )

            ;; Reset a setting.
            ;; Params:
            ;; - The name of the setting to reset.
            ;;   Defaults to #f.
            ;; - What mode to reset the setting in.
            ;;   For details, look at `update-from-engine` in `settings.gc`.
            ;;   Defaults to #f.
            ((= command 'setting-reset)
              (set-setting! (the-as symbol (command-get-param (car params) #f)) (command-get-param (car (cdr params)) #f) 0.0 0)
            )

            ;; Unset a setting. Removes it from consideration over the default value.
            ;; Params:
            ;; - The name of the setting to unset.
            ;;   Defaults to #f.
            ((= command 'setting-unset)
              (remove-setting! (the-as symbol (command-get-param (car params) #f)))
            )

            ;; Set the SFX volume.
            ;; Params:
            ;; - The mode to set the SFX volume in.
            ;;   Either 'rel or 'abs. For details, looks at `update-from-engine` in `settings.gc`.
            ;;   Defaults to #f.
            ;; - The value to set the SFX volume to.
            ;;   Defaults to 0.0.
            ((= command 'sfx-volume)
              ;; og:preserve-this PAL patch here
              (set-setting! 'sfx-volume (command-get-param (car params) #f) (command-get-float (car (cdr params)) 0.0) 0)
            )

            ;; Set the blackout time.
            ;; Params:
            ;; - The amount of time to set.
            ;;   If 0, ends blackout immediately.
            ;;   Does nothing if less then the current blackout time. 
            ;;   Defaults to 0.
            ((= command 'blackout)
              ; * 5 converts from ticks to 60fps
              (set-blackout-frames (the-as time-frame (the int (* 5.0 (the float (command-get-int (car params) 0))))))
            )

            ;; Set the next frame to be a teleport frame.
            ;; This immediately sets mood values instead of interpolating them.
            ;; No params.
            ((= command 'teleport)
              (set! *teleport* #t)
            )

            ;; Set the cam joint index of the current movie.
            ;; Sets the next two frames to be teleport frames.
            ;; Params:
            ;; - The index to set the cam joint index to,
            ;;   or the name of the joint to use the index of.
            ;;   Defaults to #f.
            ((= command 'joint)
              (send-event
                (ppointer->process (-> *setting-control* current movie))
                'joint
                (command-get-param (car params) #f)
              )
              (set! *teleport-count* 2)
            )

            ;; Spawn an ambient hint.
            ;; Params:
            ;; - The name of the sound to play.
            ;;   Defaults to #f.
            ;; - The mode of the hint to use.
            ;;   Defaults to #f.
            ((= command 'ambient)
              (ambient-hint-spawn
                (the-as string (command-get-param (car (cdr params)) #f))
                (the-as vector #f)
                *entity-pool*
                (the-as symbol (command-get-param (car params) #f))
              )
            )

            ;; Send an event. Can only send up to 3 params in the event.
            ;; Params:
            ;; - The process to send the event to.
            ;;   Includes shortcuts. See `command-list-get-process` for details.
            ;; - The message to send.
            ;;   Defaults to #f.
            ;; - The first parameter to send.
            ;;   Defaults to #f.
            ;; - The second parameter to send.
            ;;   Defaults to #f.
            ;; - The third parameter to send.
            ;;   Defaults to #f.
            ((= command 'send-event)
              (let (
                (proc (command-list-get-process (car params)))
                (message (command-get-quoted-param (car (cdr params)) #f))
                (event-params (cdr (cdr params)))
              )
                (when (and
                  proc
                  (not (null? message))
                )
                  (let ((message-block (new 'stack-no-clear 'event-message-block)))
                    (set! (-> message-block from) pp)
                    (set! (-> message-block message) (the-as symbol message))

                    (set! (-> message-block num-params)
                      ((method-of-type (rtype-of event-params) length) event-params)
                    )
                    (set! (-> message-block param 0)
                      (the-as uint (command-get-quoted-param (car event-params) #f))
                    )
                    (set! (-> message-block param 1)
                      (the-as uint (command-get-quoted-param (car (cdr event-params)) #f))
                    )
                    (set! (-> message-block param 2)
                      (the-as uint (command-get-quoted-param (car (cdr (cdr event-params))) #f))
                    )

                    (send-event-function proc message-block)
                  )
                )
              )
            )
          )
        )
      )
    )

    (none)
  )
)

(defun check-boundary ((arg0 load-boundary))
  (local-vars (s5-0 object))
  (let ((a1-0 (if (logtest? (-> arg0 flags) (load-boundary-flags player)) (-> *load-boundary-target* 1) (-> *load-boundary-target* 0)))
        (a2-0 (if (logtest? (-> arg0 flags) (load-boundary-flags player)) (-> *load-boundary-target* 3) (-> *load-boundary-target* 2))))
    0
    (let ((f0-1 (- (-> a1-0 x) (-> arg0 rejector x)))
          (f1-2 (- (-> a1-0 z) (-> arg0 rejector z))))
      (cond
        ((< (+ (square f0-1) (square f1-2)) (* (-> arg0 rejector w) (-> arg0 rejector w)))
         (if (logtest? (-> arg0 flags) (load-boundary-flags closed))
           (set! s5-0 (check-closed-boundary arg0 a1-0 a2-0))
           (set! s5-0 (check-open-boundary arg0 a1-0 a2-0))))
        (else (set! s5-0 0) (goto cfg-28)))))
  (let ((s4-0 (the-as load-boundary-crossing-command #f)))
    (if (= (the-as symbol s5-0) 1) (set! s4-0 (-> arg0 cmd-fwd)))
    (if (= (the-as symbol s5-0) 2) (set! s4-0 (-> arg0 cmd-bwd)))
    (when s4-0
      (cond
        ((= (-> s4-0 cmd) (load-boundary-cmd vis)) (load-state-want-vis (the-as symbol (-> s4-0 lev0))))
        ((= (-> s4-0 cmd) (load-boundary-cmd load))
         (load-state-want-levels (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
        ((= (-> s4-0 cmd) (load-boundary-cmd display))
         (load-state-want-display-level (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
        ((= (-> s4-0 cmd) (load-boundary-cmd force-vis))
         (load-state-want-force-vis (the-as symbol (-> s4-0 lev0)) (the-as symbol (-> s4-0 lev1))))
        ((= (-> s4-0 cmd) (load-boundary-cmd checkpt))
         (format 0 "Setting continue to ~A~%" (-> s4-0 lev0))
         (set-continue! *game-info* (-> s4-0 lev0))))))
  (label cfg-28)
  (none))

(define-perm *load-state* load-state (new 'global 'load-state))
