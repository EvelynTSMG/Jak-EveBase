      ; pink
      (new 'static 'char-color
        :color (new 'static 'array rgba 4
          (static-rgba #x80 #x40 #x80 #x80)
          (static-rgba #x80 #x40 #x80 #x80)
          (static-rgba #x30 #x00 #x30 #x80)
          (static-rgba #x30 #x00 #x30 #x80)
        )
      )

      ; menu-selected
      (new 'static 'char-color
        :color (new 'static 'array rgba 4
          (static-rgba #x60 #x80 #x80 #x80)
          (static-rgba #x60 #x80 #x80 #x80)
          (static-rgba #x00 #x40 #x60 #x80)
