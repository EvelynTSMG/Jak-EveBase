;;-*-Lisp-*-
(in-package goal)
(bundles "MIS.DGO")
(require "engine/common-obs/nav-enemy.gc")

;; DECOMP BEGINS

(deftype muse (nav-enemy)
  (
    (root               collide-shape-moving :override)
    (current-path-index float)
    (prev-path-index    float)
    (dest-path-index    float)
    (player-path-index  float)
    (max-path-index     float)
    (sprint-distance    float)
    (dest-point         vector :inline)
    (anim               spool-anim)
    (victory-anim       spool-anim)
    (old-target-pos     transformq :inline)
  )
  (:states
    muse-caught
    muse-idle
  )
)

(deftype point-on-path-segment-info (structure)
  (
    (point               vector :inline)
    (segment             vector 2 :inline)
    (dir                 vector :inline)
    (nearest-point       vector :inline)
    (segment-length      float)
    (distance-to-segment float)
    (parametric-index    float)
  )
)

(defun analyze-point-on-path-segment ((point-info point-on-path-segment-info))
  ; Set up the direction and segment length
  (vector-! (-> point-info dir) (-> point-info segment 1) (-> point-info segment 0))
  (vector-normalize! (-> point-info dir) 1.0)

  (set! (-> point-info segment-length)
    (vector-vector-distance (-> point-info segment 0) (-> point-info segment 1))
  )

  (let ((start-to-point (new 'stack-no-clear 'vector)))
    ; Set parametric-index to how far a projection of the point onto the segment
    ; is along the segment. start = 0.0, end = 1.0
    (vector-! start-to-point (-> point-info point) (-> point-info segment 0))
    (set! (-> point-info parametric-index)
      (/
        (vector-dot (-> point-info dir) start-to-point)
        (-> point-info segment-length)
      )
    )
  )

  (let ((s5-0 (new 'stack-no-clear 'vector)))
    ; s5-0 = segment-start -> point
    (vector-! s5-0 (-> point-info segment 0) (-> point-info point))
    ; s5-0 += dir * (- dot(s5-0, dir))
    (vector+*! s5-0 s5-0 (-> point-info dir) (- (vector-dot s5-0 (-> point-info dir))))
    ; nearest-point = point + s5-0
    (vector+! (-> point-info nearest-point) (-> point-info point) s5-0)
    ; distance-to-segment = |s5-0|
    (set! (-> point-info distance-to-segment) (vector-length s5-0))
  )
  
  (cond
    ; We're behind the start of the segment
    ((< (-> point-info parametric-index) 0.0)
      (set! (-> point-info parametric-index) 0.0)
      (set! (-> point-info nearest-point quad) (-> point-info segment 0 quad))
      (set! (-> point-info distance-to-segment)
        (vector-vector-distance (-> point-info nearest-point) (-> point-info point))
      )
    )

    ; We're between the start and end of the segment
    ((< 1.0 (-> point-info parametric-index))
      (set! (-> point-info parametric-index) 1.0)
      (set! (-> point-info nearest-point quad) (-> point-info segment 1 quad))
      (set! (-> point-info distance-to-segment)
        (vector-vector-distance (-> point-info nearest-point) (-> point-info point))
      )
    )
  )
)

(defbehavior muse-get-path-point muse ((arg0 vector) (arg1 int))
  (eval-path-curve-div! (-> self path) arg0 (the float arg1) 'interp)

  (none)
)

(defbehavior muse-check-dest-point muse ()
  (let (
    (point-info (new 'stack-no-clear 'point-on-path-segment-info))
    (self-min-dist-to-segment (meters 1000.0))
    (muse-t 0.0)
    (target-min-dist-to-segment (meters 1000.0))
    (target-t 0.0)
  )
    (let (
      (max-i (+ (-> self path curve num-cverts) -1))
      (target-pos (target-pos 0))
    )
      (dotimes (i max-i)
        (let ((f22-0 (the float i)))
          (let ((f20-0 (the float (+ i 1))))
            (eval-path-curve-div! (-> self path) (-> point-info segment 0) f22-0 'interp)
            (eval-path-curve-div! (-> self path) (-> point-info segment 1) f20-0 'interp)
          )

          ; Find how far along the path the target is
          (set! (-> point-info point quad) (-> target-pos quad))
          (analyze-point-on-path-segment point-info)

          (when (< (-> point-info distance-to-segment) target-min-dist-to-segment)
            (set! target-min-dist-to-segment (-> point-info distance-to-segment))
            (set! target-t (+ f22-0 (-> point-info parametric-index)))
          )

          ; Find how far along the path the muse is
          (set! (-> point-info point quad) (-> self collide-info trans quad))
          (analyze-point-on-path-segment point-info)

          (when (< (-> point-info distance-to-segment) self-min-dist-to-segment)
            (set! self-min-dist-to-segment (-> point-info distance-to-segment))
            (set! muse-t (+ f22-0 (-> point-info parametric-index)))
          )
        )
      )
    )

    (let ((target-to-muse-t (- muse-t target-t)))
      ; Loop around
      (if (< target-to-muse-t (/ (-> self max-path-index) -2))
        (+! target-to-muse-t (-> self max-path-index))
      )

      (if (> target-to-muse-t (/ (-> self max-path-index) 2))
        (-! target-to-muse-t (-> self max-path-index))
      )


      (cond
        ((>= target-to-muse-t 0.0) ; Target is behind us
          ; Let's go 2.5 nodes ahead
          (set! (-> self dest-path-index) (the float (the int (+ 2.5 muse-t))))
          (if (>= (-> self dest-path-index) (-> self max-path-index))
            (set! (-> self dest-path-index) (- (-> self dest-path-index) (-> self max-path-index)))
          )
        )

        (else ; Target is ahead of us!
          ; Turn around
          (set! (-> self dest-path-index) (+ -1.5 muse-t))
          (if (< (-> self dest-path-index) 0.0)
            (+! (-> self dest-path-index) (-> self max-path-index))
          )
          (set! (-> self dest-path-index) (the float (the int (-> self dest-path-index))))
        )
      )
    )
  )
  (eval-path-curve-div! (-> self path) (-> self dest-point) (-> self dest-path-index) 'interp)

  (none)
)

(defmethod nav-enemy-method-51 ((this muse))
  (dotimes (s5-0 2)
    (let ((v1-2 (rand-vu-int-range 3 (+ (-> this node-list length) -1))))
      (launch-particles (-> *part-id-table* 271) (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data v1-2)))
    )
  )

  (none)
)

(defmethod common-post ((this muse))
  ; Spawn extra particles
  (nav-enemy-method-51 this)
  (spool-push *art-control* (-> this anim name) 0 this -99.0)
  ((method-of-type nav-enemy common-post) this)

  (none)
)

(defskelgroup *muse-sg*
  muse
  muse-lod0-jg
  muse-idle-ja
  ((muse-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 2 0 3)
  :shadow muse-shadow-mg
)

(defmethod touch-handler ((this muse) (arg0 process) (arg1 event-message-block))
  (go muse-caught)
)

(defmethod attack-handler ((this muse) (arg0 process) (arg1 event-message-block))
  (go muse-caught)
)

;nav-enemy-default-event-handler

(defstate muse-idle (muse)
  :event nav-enemy-default-event-handler

  :trans (behavior ()
    (seek! (-> self sprint-distance) (meters 15.0) (per-second (meters 2.0)))
    (if (and
      *target*
      (>= (meters 25.0) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans)))
    )
      (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none))
    )

    (if (and
      *target*
      (>= (meters 20.0) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans)))
    )
      (go-virtual nav-enemy-chase)
    )
  )

  :code (behavior ()
    ; Transition animation from running to idle
    (when (ja-group? muse-run-ja)
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :num! (loop!))
      (ja-no-eval :group! muse-run-to-idle-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (ja-blend-eval)
        (suspend)
        (ja :num! (seek!))
      )
    )

    ; Loop idle animation
    (loop
      (ja-no-eval :group! muse-idle-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        ; Remember to spawn particles!
        (nav-enemy-method-51 self)
        (spool-push *art-control* (-> self anim name) 0 self -99.0)
        (suspend)
        (ja :num! (seek!))
      )
    )
  )

  :post ja-post
)

(defstate nav-enemy-chase (muse)
  :virtual #t

  :event nav-enemy-default-event-handler

  :enter (behavior ()
    (set-time! (-> self state-time))
  )

  :trans (behavior ()
    (cond
      ((or
        (not *target*)
        (< (meters 25.0) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans)))
      )
        (set! (-> self target-speed) 0.0)
        (if (= (-> self momentum-speed) 0.0)
          (go muse-idle)
        )
      )

      ((or
        (< (-> self sprint-distance) (vector-vector-distance (-> self collide-info trans) (-> *target* control trans)))
      )
        (set! (-> self target-speed) (meters 10.0))
      )

      (else
        (set! (-> self target-speed) (meters 15.0))
      )
    )

    (seek! (-> self sprint-distance) (meters 0.0) (per-second (meters 1.0)))

    (muse-check-dest-point)
  )

  :code (behavior ()
    (cond
      ; Transition from idle to running first
      ((ja-group? muse-idle-ja)
        (ja-channel-push! 1 (seconds 0.1))
        (ja-no-eval :num! (loop!))
        (ja-no-eval :group! muse-idle-to-run-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (ja-blend-eval)
          (suspend)
          (ja :num! (seek!))
        )
      )

      (else
        (ja-channel-push! 1 (seconds 0.1))
      )
    )

    (ja :group! muse-run-ja :num! min)
    (loop
      (suspend)
      (ja :num! (loop! (/ (-> self momentum-speed) (meters 15))))
    )
  )

  :post (behavior ()
    (set! (-> self nav destination-pos quad) (-> self dest-point quad))
    (nav-control-method-19 (-> self nav)
      (-> self nav target-pos)
      (-> self collide-info)
      (-> self nav destination-pos)
      (degrees 3000.0)
    )

    (if (logtest? (nav-control-flags navcf21) (-> self nav flags))
      (logclear! (-> self nav flags) (nav-control-flags navcf10))
    )

    (nav-enemy-travel-post)
  )
)

(defstate nav-enemy-jump (muse)
  :virtual #t

  :event nav-enemy-default-event-handler

  :enter (behavior ()
    ((-> (method-of-type nav-enemy nav-enemy-jump) enter))
    (logclear! (-> self nav-enemy-flags) (nav-enemy-flags standing-jump))
  )

  :code (-> (method-of-type nav-enemy nav-enemy-jump) code)
)

(defstate nav-enemy-jump-land (muse)
  :virtual #t

  :event nav-enemy-default-event-handler

  :code (behavior ()
    (ja-no-eval :num! (seek!))
    (ja-channel-push! 1 (seconds 0.075))
    (ja-no-eval :group! muse-run-ja :num! (seek! max 0.8) :frame-num (ja-aframe 6.0 0))
    (until (ja-done? 0)
      (ja-blend-eval)
      (suspend)
      (ja :num! (seek! max 0.8))
    )
    
    (go-virtual nav-enemy-chase)
  )
)

(defstate muse-caught (muse)
  :event #f

  :trans (behavior ()
    (spool-push *art-control* (-> self anim name) 0 self -1.0)
  )

  :code (behavior ()
    (sound-play "money-pickup")
    (close-specific-task! (game-task misty-muse) (task-status need-reminder))
    (process-entity-status! self (entity-perm-status dead) #t)
    (suspend)

    (when (send-event *target* 'clone-anim self)
      (set-blackout-frames (seconds 10))
      (let ((movie-pos (res-lump-struct (-> self entity) 'movie-pos vector)))
        (cond
          (movie-pos
            (move-to-point! (-> self collide-info) movie-pos)
            (set-yaw-angle-clear-roll-pitch! (-> self collide-info) (-> movie-pos w))
          )

          (else
            (move-to-point! (-> self collide-info) (-> *target* control trans))
            (quaternion-copy! (-> self collide-info quat) (-> *target* control quat))
            (move-to-ground (-> self collide-info) (meters 10.0) (meters 10.0) #f (collide-kind background))
          )
        )
      )

      (send-event *target* 'trans 'save (-> self old-target-pos))
      (send-event (ppointer->process (-> *target* sidekick)) 'matrix 'play-anim)
      (send-event *target* 'blend-shape #t)

      (if (!= *kernel-boot-message* 'play)
        (set! (-> self trans-hook)
          (lambda :behavior muse ()
            (spool-push *art-control* (-> self victory-anim name) 0 self -1.0)

            (none)
          )
        )
      )

      (add-setting! 'music-volume 'rel (-> *setting-control* current music-volume-movie) 0)
      (add-setting! 'sfx-volume 'rel (-> *setting-control* current sfx-volume-movie) 0)
      (add-setting! 'ambient-volume 'rel (-> *setting-control* current ambient-volume-movie) 0)

      (logclear! (-> self mask) (process-mask enemy))
      (process-spawn othercam self 3 #f #t :to self)

      (auto-save-command 'auto-save 0 0 *default-pool*)

      (ja-play-spooled-anim (-> self anim)
        (the-as art-joint-anim muse-idle-ja)
        (the-as art-joint-anim muse-idle-ja)
        (the-as (function process-drawable symbol) false-func)
      )

      (remove-setting! 'music-volume)
      (remove-setting! 'sfx-volume)
      (remove-setting! 'ambient-volume)

      (send-event *target* 'blend-shape #f)

      (cond
        ((!= *kernel-boot-message* 'play)
          (set-blackout-frames 0)

          (ja-channel-set! 0)
          (ja-post)
          (clear-collide-with-as (-> self collide-info))
          (send-event *target* 'trans 'reset)
          (let (
            (cell
              (ppointer->handle
                (birth-pickup-at-point
                  (target-pos 0)
                  (pickup-type fuel-cell)
                  (the float (-> self entity extra perm task))
                  #f
                  self
                  (the-as fact-info #f)
                )
              )
            )
          )
            (send-event (handle->process (the-as handle cell)) 'pickup)
            (while (handle->process (the-as handle cell))
              (suspend)
            )
          )
        )

        (else
          (send-event *target* 'trans 'restore (-> self old-target-pos))
          (set-blackout-frames 0)
          (set-blackout-frames (seconds 0.1))
        )
      )
    )
  )

  :post (behavior ()
    (nav-enemy-method-51 self)
    (level-hint-surpress!)
    (kill-current-level-hint '() '() 'exit)
    (ja-post)
  )
)

(define *muse-nav-enemy-info*
  (new 'static 'nav-enemy-info
    :idle-anim 3
    :walk-anim 4
    :turn-anim -1
    :notice-anim 3
    :run-anim 4
    :jump-anim 7
    :jump-land-anim 8
    :victory-anim 3
    :taunt-anim 3
    :die-anim 3
    :neck-joint 6
    :player-look-at-joint 5
    :run-travel-speed (meters 10)
    :run-rotate-speed (degrees 999.99994)
    :run-acceleration (meters 5)
    :run-turn-time (seconds 0.15)
    :walk-travel-speed (meters 10)
    :walk-rotate-speed (degrees 999.99994)
    :walk-acceleration (meters 1)
    :walk-turn-time (seconds 0.15)
    :attack-shove-back (meters 3)
    :attack-shove-up (meters 2)
    :shadow-size (meters 2)
    :notice-nav-radius (meters 1)
    :nav-nearest-y-threshold (meters 10)
    :notice-distance (meters 30)
    :stop-chase-distance (meters 40)
    :frustration-distance (meters 8)
    :frustration-time (seconds 4)
    :die-anim-hold-frame 10000000000.0
    :jump-anim-start-frame 6.5
    :jump-land-anim-end-frame 10000000000.0
    :jump-height-min (meters 1)
    :jump-height-factor 0.5
    :jump-start-anim-speed 1.0
    :shadow-max-y (meters 1)
    :shadow-min-y (meters -1)
    :shadow-locus-dist (meters 150)
    :use-align #f
    :draw-shadow #t
    :move-to-ground #t
    :hover-if-no-ground #f
    :use-momentum #f
    :use-flee #f
    :use-proximity-notice #f
    :use-jump-blocked #f
    :use-jump-patrol #f
    :gnd-collide-with (collide-kind background)
    :debug-draw-neck #f
    :debug-draw-jump #f
  )
)

(defmethod init-from-entity! ((this muse) (arg0 entity-actor))
  (stack-size-set! (-> this main-thread) 512)
  (logior! (-> this mask) (process-mask enemy))

  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) default-collision-reaction)
    (set! (-> cshape no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))

    (let ((root (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> root prim-core collide-as) (collide-kind enemy))
      (set! (-> root collide-with) (collide-kind target))
      (set! (-> root prim-core action) (collide-action solid))
      (set! (-> root prim-core offense) (collide-offense indestructible))
      (set-vector! (-> root local-sphere)
        (meters 0.0) (meters 0.6) (meters 0.0)
        (meters 0.6)
      )
      (set-root-prim! cshape root)
    )

    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (backup-collide-with-as cshape)
    
    (set! (-> this collide-info) cshape)
  )

  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *muse-sg* '())
  (logclear! (-> this mask) (process-mask actor-pause))

  (init-defaults! this *muse-nav-enemy-info*)

  (set! (-> this max-path-index) (the float (+ (-> this path curve num-cverts) -1)))
  (set! (-> this current-path-index) 7.0)
  (set! (-> this prev-path-index) 7.0)
  (set! (-> this dest-path-index) 7.0)
  (set! (-> this player-path-index) 0.0)
  (eval-path-curve-div! (-> this path) (-> this dest-point) (-> this current-path-index) 'interp)
  (set! (-> this collide-info trans quad) (-> this dest-point quad))

  (set! (-> this nav nearest-y-threshold) (meters 5.0))

  (set-vector! (-> this neck twist-max) 8192.0 8192.0 0.0 1.0)
  (set! (-> this neck up) (the-as uint 0))
  (set! (-> this neck nose) (the-as uint 1))
  (set! (-> this neck ear) (the-as uint 2))
  (set! (-> this neck max-dist) (meters 25.0))
  (set! (-> this neck ignore-angle) (degrees 90.0))
  
  (set! (-> this anim)
    (new 'static 'spool-anim
      :name "muse-victory"
      :index 9
      :parts 2
      :command-list '(
        (1 blackout 0)
        (219 blackout 60)
      )
    )
  )
  (set! (-> this victory-anim) (fuel-cell-pick-anim this))

  (go muse-idle)

  (none)
)
